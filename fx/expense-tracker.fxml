<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!-- Open this file in SceneBuilder to change the layout. Wiring lives in ExpenseController. -->
<BorderPane prefHeight="560.0" prefWidth="920.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ExpenseController">
   <top>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Expense Tracker">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <TextField fx:id="amountField" prefWidth="100.0" promptText="Amount" />
                  <ComboBox fx:id="categoryBox" prefWidth="150.0" promptText="Category" />
                  <DatePicker fx:id="dateField" prefWidth="130.0" promptText="Date" />
                  <TextField fx:id="descriptionField" promptText="Description (optional)" HBox.hgrow="ALWAYS" />
                  <Button defaultButton="true" mnemonicParsing="false" onAction="#handleAdd" text="Add" />
               </children>
            </HBox>
            <Label fx:id="errorLabel" textFill="#c62828" />
         </children>
         <padding>
            <Insets bottom="4.0" left="12.0" right="12.0" top="12.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <TableView fx:id="expenseTable" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
            <TableColumn fx:id="categoryColumn" prefWidth="130.0" text="Category" />
            <TableColumn fx:id="amountColumn" prefWidth="100.0" text="Amount" />
            <TableColumn fx:id="descriptionColumn" prefWidth="250.0" text="Description" />
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
         <BorderPane.margin>
            <Insets left="12.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <right>
      <VBox prefWidth="260.0" spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Spending by category">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <PieChart fx:id="categoryChart" animated="false" labelsVisible="false" legendVisible="false" prefHeight="260.0" VBox.vgrow="ALWAYS" />
            <VBox fx:id="legendBox" spacing="4.0" />
            <Label fx:id="totalLabel" text="Total: $0.00" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets left="12.0" right="12.0" />
         </padding>
      </VBox>
   </right>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Filter:" />
            <ComboBox fx:id="filterCategoryBox" prefWidth="150.0" promptText="All categories" />
            <DatePicker fx:id="fromDate" prefWidth="130.0" promptText="From" />
            <DatePicker fx:id="toDate" prefWidth="130.0" promptText="To" />
            <Button mnemonicParsing="false" onAction="#handleFilter" text="Apply" />
            <Button mnemonicParsing="false" onAction="#handleClearFilter" text="Clear" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleDelete" text="Delete selected" />
         </children>
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
